# Which model service runs the conversation:
#   nebius = Nebius Token Factory (NVIDIA Nemotron). This is the real thing.
#   ollama = a model on your own computer, for working offline
#   mock   = canned replies, for testing without any AI
LLM_PROVIDER=nebius

# Nebius Token Factory: create a key at https://tokenfactory.nebius.com (never commit it)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Five jobs, each on its own Nemotron model. Copy the exact model IDs from the Token Factory model list.
#   planner  = designs the whole world from your line of work: situations, objections, scoring rubric (strongest model, once per world)
#   caster   = creates each person you will meet, in parallel (fast model, 5 calls per world)
#   persona  = plays the person you are talking to (fast, called every turn)
#   director = watches how you are doing and decides how the persona should react (fast, small output)
#   coach    = writes the final report (strong reasoning, once per conversation)
# Only persona and coach are required: planner falls back to coach, caster and director fall back to persona.
NEBIUS_MODEL_PLANNER=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_CASTER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_PERSONA=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_DIRECTOR=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_COACH=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: extra JSON sent with each request for a role, e.g. to switch a model's thinking mode off.
# Nemotron 3 models think before answering unless told not to. For a spoken conversation that only adds delay, so switch thinking off:
NEBIUS_EXTRA_PERSONA={"chat_template_kwargs": {"enable_thinking": false}}
NEBIUS_EXTRA_DIRECTOR={"chat_template_kwargs": {"enable_thinking": false}}
NEBIUS_EXTRA_CASTER={"chat_template_kwargs": {"enable_thinking": false}}
NEBIUS_EXTRA_PLANNER={"chat_template_kwargs": {"enable_thinking": false}}
NEBIUS_EXTRA_COACH={"chat_template_kwargs": {"enable_thinking": true}}

# Optional: Tavily web search, used to research the person you are about to talk to
TAVILY_API_KEY=

# Local fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_MODEL=llama3.1:8b

# Safety for a public demo: most calls one visitor may make per hour, and a daily cap on all model calls
RATE_LIMIT_PER_HOUR=60
WORLD_RATE_PER_HOUR=6
DAILY_CALL_CAP=1500
# New worlds built per day across all visitors. Worlds already built are cached, so repeats cost nothing.
WORLD_BUILD_CAP=30

# Optional: Azure Speech neural voices (free F0 tier, 500K characters a month). Leave blank to use the browser/Kokoro voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_MONTHLY_CHAR_CAP=450000
